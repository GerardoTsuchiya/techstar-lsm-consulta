# Dependencias y compilación
node_modules/
dist/
coverage/
*.tsbuildinfo

# Material de elicitación: NO se sube al repositorio (TECHSTAR_MVP.md §2).
# Contiene transcripciones, audio/video y nombres de participantes.
Entrevistas/

# Capturas, clips o grabaciones de consulta: nunca se versionan (RF-18).
capturas/
*.mp4
*.webm
*.mov
# Única excepción: recursos en LSM aprobados del catálogo (videos de referencia, no de consulta).
# Solo esta carpeta; `npm run validar-catalogo` avisa de cualquier archivo que no esté en el catálogo.
!public/recursos/*.mp4
!public/recursos/*.webm
# Videos candidatos descargados de Iztacala Enseña e Indiscapacidad: sin permiso de redistribución.
# Se regeneran con recursos-candidatos/descargar.py; README, procedencia e índices sí se versionan.
recursos-candidatos/videos/
# Puntos de hombros y manos extraídos de esos videos (se regeneran con `npm run herramienta-puntos`).
recursos-candidatos/puntos/

# Entorno local
.env
.env.*
*.log
.DS_Store
Thumbs.db

# Documentos de trabajo del equipo (SRS, lista de requerimientos, estado, registro de elicitación) y presentaciones.
# Se quedan en las computadoras del equipo, fuera del repositorio.
Docs/
Presentacion 4 Nov/

# Configuración local de herramientas
.claude/settings.local.json

# Compilación de Electron
dist-electron/
